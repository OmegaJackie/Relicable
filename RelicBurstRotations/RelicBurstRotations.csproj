<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RelicBurstRotations</AssemblyName>
    <RootNamespace>RelicBurstRotations</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ===================================================================================
         THIS PROJECT IS A COMPILE-VERIFICATION HARNESS, NOT A SHIPPABLE ARTIFACT.

         Rotation Solver Reborn 7.5.1.17 does not load rotations from disk at all:
         RotationUpdater.LoadBuiltInRotations() is
             List<Assembly> assemblies = [typeof(RotationUpdater).Assembly];
         with no other loader, no directory path, no "*.dll" search pattern and no
         Assembly.LoadFrom anywhere in the shipped binary. The rotations RSR offers are compiled
         INTO RotationSolver.dll (namespaces RotationSolver.RebornRotations.* and
         RotationSolver.ExtraRotations.*). pluginConfigs\RotationSolver\Rotations\*.dll is a dead
         leftover from an older RSR and is never read.

         So RelicBurstRotations.dll can NEVER be discovered by RSR, and there is deliberately no
         post-build copy step here: there is nowhere to copy it TO. Do not add one, and do not
         drop the output into any plugin folder.

         To actually run these rotations, source-drop them into a RotationSolver fork:
           1. clone FFXIV-CombatReborn/RotationSolverReborn at tag 7.5.1.17;
           2. copy IfritExBurst.cs and Rotations\*.cs into the RotationSolver project  -  the
              namespaces are file-scoped (RelicBurstRotations[.Rotations]) so nothing needs
              rewiring, and RotationSolver.Basic ships [assembly: InternalsVisibleTo("RotationSolver")]
              so anything reaching RSR internals only compiles inside that assembly anyway;
           3. build and replace RotationSolver.dll in the installed plugin directory.
         Dalamud auto-updates RSR into a new version-stamped directory, so every RSR release undoes
         step 3. Relicable therefore defaults AutoSwapIfritBurstRotation to OFF, reports
         "not present in your RotationSolver build" in /relic config when the swap cannot apply, and
         warns when the RSR assembly version changes under a live override.

         What this project IS for: `dotnet build` here type-checks all eleven source files against
         the exact RotationSolverReborn.Basic 7.5.1.17 API before they are dropped into the fork.
         =================================================================================== -->

    <!-- A rotation library is a plain classlib. Do NOT add Dalamud.NET.Sdk, DalamudPackager,
         or a plugin manifest json. Do NOT copy the Dalamud/RSR reference assemblies to output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DalamudLibPath>$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RotationSolverReborn.Basic" Version="7.5.1.17" />
  </ItemGroup>

  <!-- Dalamud reference assemblies. HintPath into Hooks\dev, always Private=False. -->
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Global usings every rotation file assumes. Note: Dalamud.Bindings.ImGui, NOT ImGuiNET. -->
  <ItemGroup>
    <Using Include="System.ComponentModel" />
    <Using Include="System.Numerics" />
    <Using Include="System.Reflection" />
    <Using Include="Dalamud.Game.ClientState.JobGauge.Enums" />
    <Using Include="Dalamud.Game.ClientState.JobGauge.Types" />
    <Using Include="Dalamud.Game.ClientState.Objects.Types" />
    <Using Include="Dalamud.Interface" />
    <Using Include="Dalamud.Bindings.ImGui" />
    <Using Include="Newtonsoft.Json" />
    <Using Include="RotationSolver.Basic" />
    <Using Include="RotationSolver.Basic.Actions" />
    <Using Include="RotationSolver.Basic.Attributes" />
    <Using Include="RotationSolver.Basic.Configuration.RotationConfig" />
    <Using Include="RotationSolver.Basic.Data" />
    <Using Include="RotationSolver.Basic.Helpers" />
    <Using Include="RotationSolver.Basic.Rotations" />
    <Using Include="RotationSolver.Basic.Rotations.Basic" />
  </ItemGroup>

</Project>

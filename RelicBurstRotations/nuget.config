<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Reproducible offline restore: RotationSolverReborn.Basic 7.5.1.17 is NOT on nuget.org,
         it ships inside the installed RSR plugin folder. A copy lives in .\packages\.
         nuget.org is kept as a fallback for the transitive deps (ECommons, Svg,
         Microsoft.CodeAnalysis.CSharp, System.Drawing.Common) which are already in the
         machine's global packages folder, so a fully offline restore also works. -->
    <clear />
    <add key="local-rsr" value=".\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

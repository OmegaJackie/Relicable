<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline Early Alpha code generator. Maintainer-only: it holds the private key
    that signs access codes, and is never shipped to users.

    It is deliberately NOT a Dalamud project - it is a plain console app with no
    game dependencies, so it builds and runs anywhere the .NET 10 SDK is installed
    without XIVLauncher present.

    Run it from the repository root; see tools/RelicableKeygen/README.md for the
    full command list (init, mint, verify, inspect).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Relicable.Keygen</RootNamespace>
    <AssemblyName>RelicableKeygen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The code format is defined in exactly ONE file, shared by source with the
      plugin. Linking it (rather than copying it) is what guarantees the minting
      side and the verifying side can never drift out of sync: a change to the
      payload layout or the signature parameters breaks both builds at once.
    -->
    <Compile Include="..\..\Relicable\Licensing\AlphaCode.cs" Link="AlphaCode.cs" />
  </ItemGroup>

</Project>
